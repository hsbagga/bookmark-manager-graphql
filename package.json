{
  "name": "bookmark-manager-graphql",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test tests/*.test.ts",
    "test:integration": "bun test ./tests/integration/bookmark.integration.ts",
    "gendb": "bunx prisma migrate dev",
    "seed": "bun run prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sanity": "bun run lint && bun run typecheck && bun run test && bun run test:integration"
  },
  "devDependencies": {
    "bun-types": "^1.4.0",
    "eslint": "^10.9.1",
    "prisma": "^7.9.1",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0",
    "pg": "^8.23.0"
  }
}
